{"name":"preview.get","description":"Request a playable MP4 of a pinned project, recording or relocated package. Projects accept an optional range in project microseconds; omitted range renders the whole project. Recording/package previews retain their current pointer and acquired audio. Returns readiness until complete; pin the returned revision when polling. CLI writes a file; MCP returns a delivery token for artifact.read/close.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"anyOf":[{"type":"object","properties":{"recordingId":{"type":"string","minLength":1},"revisionId":{"type":"string","minLength":1}},"required":["recordingId"],"additionalProperties":false},{"type":"object","properties":{"packageHandle":{"type":"string","minLength":1},"revisionId":{"type":"string","minLength":1}},"required":["packageHandle"],"additionalProperties":false}]},{"type":"object","properties":{"projectId":{"type":"string","minLength":1},"revisionId":{"type":"string","minLength":1},"range":{"type":"object","properties":{"startUs":{"type":"integer","minimum":0,"maximum":9007199254740991},"endUs":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["startUs","endUs"],"additionalProperties":false}},"required":["projectId"],"additionalProperties":false}]}}
