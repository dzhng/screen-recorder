const { values } = parseArgs({
  options: {
    out: { type: "string" },
    fixture: { type: "string", default: "repeated-picture" },
  },
});
assert.equal(values.fixture, "repeated-picture");
assert.ok(process.env.SCREENREC_NATIVE, "Freeze a native worker before this journey");
