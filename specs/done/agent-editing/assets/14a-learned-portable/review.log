          if (["media.audioCapabilities", "media.mixCompositionAudio"].includes(operation)) {
            report.trace.push({ refusedNativeOperation: operation });
            return {
              ok: false,
              error: {
                code: "NOT_READY",
                message: "Processing unavailable for transfer verification",
                retryable: false,
