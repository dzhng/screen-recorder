{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@screenrec/macos#build": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "SCREENREC_SPARKLE_FRAMEWORK",
        "SCREENREC_RELEASE_BUILD",
        "SCREENREC_RELEASE_IDENTITY_P12",
        "SCREENREC_RELEASE_IDENTITY_PASSWORD",
        "SCREENREC_RELEASE_IDENTITY_SHA1",
        "SCREENREC_RELEASE_CERTIFICATE_SHA256",
        "SCREENREC_SPARKLE_PRIVATE_KEY",
        "SCREENREC_SPARKLE_PUBLIC_KEY"
      ],
      "cache": false,
      "outputs": []
    },
    "@screenrec/macos#test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["SCREENREC_SPARKLE_FRAMEWORK"],
      "cache": false
    },
    "@screenrec/test-harness#test": {
      "dependsOn": ["build", "@screenrec/macos#build"],
      "passThroughEnv": ["SCREENREC_SPARKLE_FRAMEWORK"],
      "cache": false
    }
  },
  "globalDependencies": ["tsconfig.base.json"]
}
