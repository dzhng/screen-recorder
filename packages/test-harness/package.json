{
  "name": "@screenrec/test-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.check.json",
    "test": "node dist/bootstrap.js && node --test speech/evaluate.test.mjs editing/speech/annotation-time.test.mjs editing/speech-labeling.test.mjs",
    "lab:index": "node --test ../../apps/macos/tests/index-lab.mjs",
    "lab:index-scale": "node --test ../../apps/macos/tests/index-scale.mjs",
    "lab:storage": "node --test storage.mjs",
    "lab:render-timing": "node --test render-timing.mjs",
    "lab:package-archive": "node --test ../../apps/macos/tests/package-archive.mjs",
    "lab:exports": "node package-exports.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@screenrec/client": "workspace:*",
    "@screenrec/core": "workspace:*",
    "@screenrec/protocol": "workspace:*",
    "zod": "4.6.5"
  }
}
