+- (BOOL)acquireReplacementLock:(NSError * __autoreleasing *)error SPU_OBJC_DIRECT
+{
+    NSString *relativePath = [_host objectForInfoDictionaryKey:@"YapLaunchLockRelativePath" ofClass:[NSString class]];
+    if (![relativePath isKindOfClass:[NSString class]] || relativePath.length == 0 || relativePath.isAbsolutePath ||
+        ![relativePath isEqualToString:relativePath.stringByStandardizingPath]) {
+        *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUInstallationError userInfo:@{NSLocalizedDescriptionKey: @"Missing or invalid YapLaunchLockRelativePath in the installed host"}];
+        return NO;
+    }
+    for (NSString *component in relativePath.pathComponents) {
+        if ([component isEqualToString:@".."] || [component isEqualToString:@"."]) {
+            *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUInstallationError userInfo:@{NSLocalizedDescriptionKey: @"Launch lock path must stay inside the account home"}];
+            return NO;
+        }
+    }
+    NSString *path = [_homeDirectory stringByAppendingPathComponent:relativePath];
+    struct passwd *account = getpwnam(_userName.UTF8String);
+    int descriptor = open(path.fileSystemRepresentation, O_RDWR | O_NOFOLLOW | O_CLOEXEC);
+    struct stat opened, named;
+    BOOL valid = account != NULL && descriptor >= 0 && fstat(descriptor, &opened) == 0 &&
+        lstat(path.fileSystemRepresentation, &named) == 0 && S_ISREG(opened.st_mode) &&
+        opened.st_uid == account->pw_uid && opened.st_nlink == 1 &&
+        (opened.st_mode & 0077) == 0 && opened.st_dev == named.st_dev && opened.st_ino == named.st_ino;
+    if (!valid || flock(descriptor, LOCK_EX | LOCK_NB) != 0) {
+        if (descriptor >= 0) close(descriptor);
+        *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUInstallationError userInfo:@{NSLocalizedDescriptionKey: @"Launch lock is unavailable; update deferred without terminating the application"}];
+        return NO;
+    }
+    _replacementLock = [[NSFileHandle alloc] initWithFileDescriptor:descriptor closeOnDealloc:YES];
+    return YES;
+}
+
+- (void)cancelInstallationForReason:(uint8_t)reason SPU_OBJC_DIRECT
+{
+    if (_finishingInstallation) {
+        uint8_t tooLate = 2;
+        [_communicator handleMessageWithIdentifier:SPUInstallationCancelled data:[NSData dataWithBytes:&tooLate length:sizeof(tooLate)]];
+        return;
+    }
+    if (_cancelling) return;
+    _cancelling = YES;
+    _finalInstallationAuthorized = NO;
+    // A disconnected host cannot acknowledge revocation; any queued host copy
+    // still owns exclusion until its SDK callback is suppressed.
+    if (_communicator == nil) [self cleanupAndExitWithStatus:EXIT_FAILURE error:nil];
+    _cancellationReason = reason;
+    // Keep exclusion until the host suppresses pending permission and closes its copy.
+    [_communicator handleMessageWithIdentifier:SPUInstallationCancellationRequested data:[NSData dataWithBytes:&reason length:sizeof(reason)]];
+}
+
+- (void)finishCancellationIfAcknowledged SPU_OBJC_DIRECT
+{
+    if (!_cancelling || !_hostAcknowledgedCancellation || _lockTransferPending || _cancellationCompleted) return;
+    _cancellationCompleted = YES;
+    [_replacementLock closeAndReturnError:NULL];
+    _replacementLock = nil;
+    [_communicator handleMessageWithIdentifier:SPUInstallationCancelled data:[NSData dataWithBytes:&_cancellationReason length:sizeof(_cancellationReason)]];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(YapReplyTimeout * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        [self cleanupAndExitWithStatus:EXIT_SUCCESS error:nil];
+    });
+}
