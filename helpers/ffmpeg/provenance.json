{
  "version": "9.0.2",
  "sourceUrl": "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz",
  "sourceSha256": "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e",
  "architecture": "arm64",
  "minimumMacOS": "26.0",
  "license": "LGPL-2.1-or-later",
  "configure": [
    "--prefix=/",
    "--enable-shared",
    "--disable-static",
    "--disable-autodetect",
    "--disable-gpl",
    "--disable-nonfree",
    "--disable-version3",
    "--disable-doc",
    "--disable-ffplay",
    "--arch=arm64",
    "--target-os=darwin",
    "--cc=/usr/bin/clang",
    "--cxx=/usr/bin/clang++",
    "--install-name-dir=@rpath",
    "--enable-videotoolbox",
    "--enable-audiotoolbox",
    "--enable-zlib",
    "--enable-bzlib",
    "--enable-securetransport",
    "--extra-cflags=-mmacosx-version-min=26.0",
    "--extra-ldflags=-mmacosx-version-min=26.0 -Wl,-rpath,@executable_path/../lib",
    "--enable-libzimg"
  ],
  "requiredFilters": [
    "ebur128",
    "loudnorm",
    "alimiter",
    "sidechaincompress",
    "tonemap",
    "lut3d",
    "colorbalance",
    "colorspace",
    "zscale"
  ],
  "requiredEncoders": ["h264_videotoolbox", "hevc_videotoolbox", "aac", "pcm_f32le"],
  "dependencies": [
    {
      "name": "zimg",
      "version": "3.0.6",
      "archive": "zimg-3.0.6.tar.gz",
      "directory": "zimg-release-3.0.6",
      "sourceUrl": "https://codeload.github.com/sekrit-twc/zimg/tar.gz/refs/tags/release-3.0.6",
      "sourceSha256": "be89390f13a5c9b2388ce0f44a5e89364a20c1c57ce46d382b1fcc3967057577",
      "license": "WTFPL",
      "licenseFile": "COPYING",
      "role": "runtime",
      "build": {
        "sourceManifest": "Makefile.am",
        "sourceSections": ["libzimg_internal_la_SOURCES", "ARMSIMD"],
        "compiler": "/usr/bin/clang++",
        "flags": [
          "-std=c++14",
          "-O2",
          "-DNDEBUG",
          "-DZIMG_ARM",
          "-fvisibility=hidden",
          "-mmacosx-version-min=26.0",
          "-dynamiclib",
          "-install_name",
          "@rpath/libzimg.2.dylib"
        ],
        "library": "libzimg.2.dylib"
      }
    },
    {
      "name": "pkgconf",
      "version": "2.5.1",
      "archive": "pkgconf-2.5.1.tar.xz",
      "directory": "pkgconf-2.5.1",
      "sourceUrl": "https://distfiles.ariadne.space/pkgconf/pkgconf-2.5.1.tar.xz",
      "sourceSha256": "cd05c9589b9f86ecf044c10a2269822bc9eb001eced2582cfffd658b0a50c243",
      "license": "ISC",
      "licenseFile": "COPYING",
      "role": "build-only",
      "build": {
        "configure": ["--disable-shared", "--disable-static", "--disable-tests"]
      }
    }
  ]
}
